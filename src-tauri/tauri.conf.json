{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Automation",
  "version": "0.1.0",
  "identifier": "com.helper.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build && node scripts/bundle-node.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Automation",
        "width": 1280, "minWidth": 720,
        "height": 820, "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources/node.exe": "browser-worker/node.exe",
      "../browser-worker/worker.mjs": "browser-worker/worker.mjs",
      "../browser-worker/policy.mjs": "browser-worker/policy.mjs",
      "../node_modules/playwright-core/": "browser-worker/node_modules/playwright-core/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
