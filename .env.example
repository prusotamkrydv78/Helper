# Copy to `.env` (git-ignored) for local development. Only read by debug builds.
# You can also skip this file and save the key in Settings → AI model instead,
# which stores it in the OS credential store.

# Required for live chat (unless saved in Settings)
OPENAI_API_KEY=

# Optional: default model when Settings → Model is empty (built-in fallback: gpt-4o-mini)
OPENAI_MODEL=

# Optional: force reasoning_effort on every request (e.g. none, low)
OPENAI_REASONING_EFFORT=

# Optional: alternative OpenAI-compatible base URL (default https://api.openai.com/v1)
OPENAI_BASE_URL=
